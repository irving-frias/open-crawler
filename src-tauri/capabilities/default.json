{
  "identifier": "default",
  "description": "Main + project window capabilities",
  "windows": ["main", "project-*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-read",
      "allow": [{ "path": "$APPDATA/transfers" }, { "path": "$APPDATA/transfers/**" }]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [{ "path": "$APPDATA/transfers" }, { "path": "$APPDATA/transfers/**" }]
    },
    {
      "identifier": "fs:allow-open",
      "allow": [{ "path": "$APPDATA/transfers" }, { "path": "$APPDATA/transfers/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/transfers" }, { "path": "$APPDATA/transfers/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA/transfers" }, { "path": "$APPDATA/transfers/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/transfers" }, { "path": "$APPDATA/transfers/**" }]
    },
    "notification:default"
  ]
}
