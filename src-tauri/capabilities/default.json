{
  "identifier": "default",
  "description": "Main + project window capabilities",
  "windows": ["main", "project-*"],
  "permissions": [
    "core:default",
    "shell:default",
    "dialog:default",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "notification:default"
  ]
}
